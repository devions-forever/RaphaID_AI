# =============================================================================
# Python / ML Project .gitignore
# =============================================================================

# ---------- Byte-compiled / Optimized / DLL files ----------
__pycache__/
*.py[cod]
*$py.class

# ---------- Distribution / Packaging ----------
build/
dist/
*.egg-info/
*.egg
*.whl

# ---------- Virtual environments ----------
venv/
env/
.env/
.venv/

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---------- Jupyter Notebooks ----------
.ipynb_checkpoints/
*.ipynb_checkpoints

# ---------- Data (large files — download separately) ----------
data/raw/
data/processed/
data/yolo_dataset/
dataset/

# ---------- Model weights (large binaries) ----------
models/
*.pt
*.pth
*.onnx
*.engine
*.tflite

# ---------- Ultralytics YOLO runs ----------
runs/

# ---------- Logs ----------
*.log
logs/
wandb/
mlruns/

# ---------- OS files ----------
.DS_Store
Thumbs.db

# ---------- Environment variables ----------
.env
.env.local

# ---------- Local working docs (not for team commits) ----------
UI_UPGRADE_PLAN.md
UI_UPGRADE_PROGRESS.md

# ---------- Streamlit / RaphaID runtime artefacts (regenerated on run) ----------
data/vector_index/
test_sessions/
streamlit_err.txt
streamlit_out.txt

# ---------- Streamlit secrets — never commit ----------
.streamlit/secrets.toml

# ---------- Local UI verification output (screenshots, smoke logs) ----------
ui_shots/
.playwright-cli/

# ---------- Tool caches ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Merge / patch leftovers ----------
*.orig
*.rej

!models/best.pt
!results/
!results/*.png
!results/*.json


.workbuddy-ai/
